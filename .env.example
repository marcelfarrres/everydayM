# EverydayM Studio (solo local en .env.local, NUNCA en Vercel)
STUDIO_ENABLED=
# PIN (mín. 6 caracteres) para abrir el Studio desde el móvil por la WiFi de casa. Vacío = desactivado
STUDIO_LAN_PIN=
# Secreto que firma la sesión del PIN (mín. 32 caracteres, solo servidor, nunca NEXT_PUBLIC_).
# Sin él, el acceso con PIN por la WiFi no funciona (localhost sí). Genera uno con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
STUDIO_SESSION_SECRET=

# Configuración de IA para generación de rutinas (servidor)
GEMINI_API_KEY=
GEMINI_MODEL=

# Medios en Bunny (Storage + CDN). Las tres BUNNY_STORAGE_* solo en el servidor del Studio
BUNNY_STORAGE_ZONE=
BUNNY_STORAGE_HOST=
BUNNY_STORAGE_KEY=
# URL pública de la pull zone de Bunny (la lee el navegador; el catálogo está en <URL>/catalog/catalog.json).
# Sin las BUNNY_STORAGE_* y con «npm run dev», los archivos van a .media/ y se sirven en /dev-media
# (deja esta variable vacía o pon /dev-media). En producción sin Bunny el Estudio da error.
NEXT_PUBLIC_MEDIA_BASE_URL=
