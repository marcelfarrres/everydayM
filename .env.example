# Configuración pública de Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# EverydayM Studio (solo local en .env.local, NUNCA en Vercel)
SUPABASE_SERVICE_ROLE_KEY=
STUDIO_ENABLED=
# PIN (mín. 6 caracteres) para abrir el Studio desde el móvil por la WiFi de casa. Vacío = desactivado
STUDIO_LAN_PIN=

# Configuración de IA para generación de rutinas (servidor)
GEMINI_API_KEY=
GEMINI_MODEL=

# Medios en Bunny (Storage + CDN). Las tres BUNNY_STORAGE_* solo en el servidor del Studio
BUNNY_STORAGE_ZONE=
BUNNY_STORAGE_HOST=
BUNNY_STORAGE_KEY=
# URL pública de la pull zone de Bunny (la lee el navegador)
NEXT_PUBLIC_MEDIA_BASE_URL=
